# Inlined into the browser bundle at `next build` time: changing it later
# has no effect on an already built app or Docker image.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional, demo only: lists the labelled every-minute Frequency in the Schedule popover.
# Needs the backend flag app.scheduler.demo-enabled (profile local). Inlined at build time.
# NEXT_PUBLIC_DEMO_SCHEDULE=true
