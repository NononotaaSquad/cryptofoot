{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore \"**/*.{ts,tsx,css,json,md,mjs,js}\"",
    "format:check": "prettier --check --ignore-path ../../.gitignore --ignore-path ../../.prettierignore \"**/*.{ts,tsx,css,json,md,mjs,js}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:gen": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@workspace/ui": "*",
    "lucide-react": "^1.66.0",
    "motion": "^14.12.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^10",
    "orval": "^8.47.0",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
