meta {
  name: The no-results report is empty with its limitations
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/1/analyses/{{noResultsAnalysisId}}/report
  body: none
  auth: none
}

tests {
  const body = res.getBody();
  test('200 OK', () => expect(res.getStatus()).to.equal(200));
  test('no Attributions, no Excluded Addresses', () => {
    expect(body.attributions).to.eql([]);
    expect(body.excludedAddresses).to.eql([]);
  });
  test('limitations name the unavailable source only', () => expect(body.limitations).to.eql(['SOURCE_UNAVAILABLE', 'ANALYSIS_INCOMPLETE']));
}
