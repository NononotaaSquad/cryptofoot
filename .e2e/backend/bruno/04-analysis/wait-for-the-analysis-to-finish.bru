meta {
  name: Wait for the Analysis to finish
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/1/analyses/{{analysisId}}
  body: none
  auth: none
}

script:pre-request {
  // Polls the Analysis until it leaves RUNNING (at most 60 s); the request itself then reads the finished Analysis.
  const axios = require('axios');
  const url = bru.getEnvVar('baseUrl') + '/api/1/analyses/' + bru.getVar('analysisId');
  const deadline = Date.now() + 60000;
  while (Date.now() < deadline) {
    const res = await axios.get(url, { validateStatus: () => true });
    if (res.status !== 200 || res.data.status !== 'RUNNING') break;
    await bru.sleep(500);
  }
}

tests {
  const body = res.getBody();
  test('200 OK', () => expect(res.getStatus()).to.equal(200));
  test('the Analysis has finished as PARTIAL', () => {
    expect(body.status).to.equal('PARTIAL');
    expect(body.finishedAt).to.be.a('string');
    expect(body.trigger).to.equal('MANUAL');
    expect(body.networks).to.eql(['BTC', 'ETH']);
    expect(body.algorithmVersion).to.equal('confidence-2');
  });
  test('source coverage: the synthetic source was checked, the broken one is unavailable', () => {
    const coverage = {};
    body.sources.forEach((s) => { coverage[s.sourceName] = [s.status, s.synthetic, s.mentionCount]; });
    expect(coverage).to.eql({ synthetic: ['CHECKED', true, 3], 'synthetic-broken': ['UNAVAILABLE', true, 0] });
  });
  test('four valid candidates, each an Attribution or an Excluded Address; both BTC addresses are attributed', () => {
    expect(body.attributionCount + body.excludedAddressCount).to.equal(4);
    expect(body.attributionCount).to.be.at.least(2);
  });
}
