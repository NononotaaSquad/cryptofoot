meta {
  name: Get the report
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/1/analyses/{{analysisId}}/report
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  bru.setVar('reportJson', JSON.stringify(body));
}

tests {
  const body = res.getBody();
  test('200 OK', () => expect(res.getStatus()).to.equal(200));
  const attributions = body.attributions;
  const byAddress = (address) => attributions.find((a) => a.address === address);
  test('the report belongs to the Analysis', () => expect(body.analysis.id).to.equal(bru.getVar('analysisId')));
  test('Attributions are sorted by Confidence Level, highest first', () => {
    const levels = attributions.map((a) => a.confidenceLevel);
    expect(levels).to.eql(levels.slice().sort((a, b) => b - a));
  });
  test('BTC 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa: 75, sale plus independent sources, nickname only', () => {
    const btc = byAddress('1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa');
    expect(btc.network).to.equal('BTC');
    expect(btc.confidenceLevel).to.equal(75);
    expect(btc.classificationStatus).to.equal('NOT_EXCLUDED');
    expect(btc.scoringRules.map((r) => r.rule)).to.eql(['SALE_OR_SETTLEMENT', 'INDEPENDENT_SOURCES', 'NICKNAME_ONLY']);
    expect(btc.mentions.map((m) => m.url).sort()).to.eql(['https://forum.example/t/porady-p2p-od-zenka/123', 'https://x.example/zenek_fx/status/555']);
  });
  test('BTC Justification is the Polish template text', () => {
    expect(byAddress('1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa').justification).to.equal(
      'Adres podano w ogłoszeniu sprzedaży lub w kontekście rozliczenia (forum.example). ' +
      'Niezależne źródła różnego pochodzenia (forum.example, x.example) wskazują na ten sam adres. ' +
      'Adres łączy z badaną osobą tylko nick lub login, które mogą należeć do innej osoby.'
    );
  });
  test('ETH 0x5aaeb6053f3e94c9b9a09f33669435e7ef1beaed (canonical): an Excluded Address, or 75 (59 when unclassified) with the same rules as BTC', () => {
  {
    const attributed = body.attributions.filter((a) => a.address === '0x5aaeb6053f3e94c9b9a09f33669435e7ef1beaed');
    const excluded = body.excludedAddresses.filter((e) => e.address === '0x5aaeb6053f3e94c9b9a09f33669435e7ef1beaed');
    expect(attributed.length + excluded.length, 'exactly one outcome').to.equal(1);
    if (excluded.length) {
      expect(excluded[0].network).to.equal('ETH');
      expect(excluded[0].reason).to.equal('SMART_CONTRACT');
      expect(excluded[0].classificationSource).to.be.a('string').and.not.empty;
      expect(excluded[0].mentions.map((m) => m.url).sort()).to.eql(['https://forum.example/t/porady-p2p-od-zenka/123','https://x.example/zenek_fx/status/555']);
    } else {
      const a = attributed[0];
      expect(a.network).to.equal('ETH');
      expect(a.classificationStatus).to.be.oneOf(['NOT_EXCLUDED', 'UNAVAILABLE']);
      // an unclassified Attribution is still scored, flagged with a 0-point rule and capped at 59 by CLASSIFICATION_CAP
      const unavailable = a.classificationStatus === 'UNAVAILABLE';
      const flagRules = unavailable ? ['CLASSIFICATION_UNAVAILABLE', 'CLASSIFICATION_CAP'] : [];
      const flagText = unavailable ? ' Nie udało się sprawdzić, czy adres należy do giełdy, kontraktu lub innej usługi. Z tego powodu stopień pewności ograniczono, tak aby nie wskazywał wysokiego prawdopodobieństwa.' : '';
      if (unavailable) expect(body.limitations).to.include('CLASSIFICATION_UNAVAILABLE');
      expect(a.confidenceLevel).to.equal(unavailable ? 59 : 75);
      expect(a.scoringRules.map((r) => r.rule)).to.eql(['SALE_OR_SETTLEMENT', 'INDEPENDENT_SOURCES', 'NICKNAME_ONLY'].concat(flagRules));
    }
  }
  });
  test('bech32 bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4: 60, one sale Mention only', () => {
    const bech32 = byAddress('bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4');
    expect(bech32.confidenceLevel).to.equal(60);
    expect(bech32.scoringRules.map((r) => r.rule)).to.eql(['SALE_OR_SETTLEMENT', 'NICKNAME_ONLY']);
    expect(bech32.mentions.map((m) => m.url)).to.eql(['https://p2p.example/ad/987']);
  });
  test('the exchange hot-wallet contract is an Excluded Address, or flagged UNAVAILABLE when its check failed', () => {
  {
    const attributed = body.attributions.filter((a) => a.address === '0xde0b295669a9fd93d5f28d9ec85e40f4cb697bae');
    const excluded = body.excludedAddresses.filter((e) => e.address === '0xde0b295669a9fd93d5f28d9ec85e40f4cb697bae');
    expect(attributed.length + excluded.length, 'exactly one outcome').to.equal(1);
    if (excluded.length) {
      expect(excluded[0].network).to.equal('ETH');
      expect(excluded[0].reason).to.equal('SMART_CONTRACT');
      expect(excluded[0].classificationSource).to.be.a('string').and.not.empty;
      expect(excluded[0].mentions.map((m) => m.url).sort()).to.eql(['https://p2p.example/ad/987']);
    } else {
      const a = attributed[0];
      expect(a.network).to.equal('ETH');
      expect(a.classificationStatus).to.be.oneOf(['NOT_EXCLUDED', 'UNAVAILABLE']);
      // an unclassified Attribution is still scored, flagged with a 0-point rule and capped at 59 by CLASSIFICATION_CAP
      const unavailable = a.classificationStatus === 'UNAVAILABLE';
      const flagRules = unavailable ? ['CLASSIFICATION_UNAVAILABLE', 'CLASSIFICATION_CAP'] : [];
      const flagText = unavailable ? ' Nie udało się sprawdzić, czy adres należy do giełdy, kontraktu lub innej usługi. Z tego powodu stopień pewności ograniczono, tak aby nie wskazywał wysokiego prawdopodobieństwa.' : '';
      if (unavailable) expect(body.limitations).to.include('CLASSIFICATION_UNAVAILABLE');
      expect(a.classificationStatus).to.equal('UNAVAILABLE');
      expect(a.confidenceLevel).to.equal(59);
      expect(a.scoringRules.map((r) => r.rule)).to.eql(['SALE_OR_SETTLEMENT', 'NICKNAME_ONLY'].concat(flagRules));
    }
  }
  });
  test('every Attribution has a Justification and the Mentions it rests on', () => {
    attributions.forEach((a) => {
      expect(a.justification).to.be.a('string').and.not.empty;
      expect(a.mentions).to.not.be.empty;
    });
  });
  test('every Attribution has Premises and every premiseIds entry is one of them', () => {
    attributions.forEach((a) => {
      expect(a.premises).to.not.be.empty;
      const ids = a.premises.map((p) => p.id);
      a.scoringRules.forEach((r) => expect(ids).to.include.members(r.premiseIds));
    });
  });
  test('Address Activity: the demo addresses carry synthetic data with cash-out signals in time order', () => {
    const btc = byAddress('1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa');
    expect(btc.addressActivityStatus).to.equal('AVAILABLE');
    expect(btc.addressActivity.synthetic).to.equal(true);
  expect([btc.addressActivity.rulesVersion, btc.addressActivity.stablecoinSwapThreshold]).to.eql(['activity-1', 1000]);
    expect([btc.addressActivity.unit, btc.addressActivity.totalReceived, btc.addressActivity.totalSent, btc.addressActivity.transactionCount]).to.eql(['BTC', 0.75, 0.25, 4]);
    expect(btc.addressActivity.cashOutSignals).to.eql([]);
    const bech32 = byAddress('bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4');
    expect(bech32.addressActivity.cashOutSignals.map((s) => [s.kind, s.occurredAt, s.amount, s.unit])).to.eql([['P2P', '2026-10-05T09:40:00Z', 1.1, 'BTC']]);
    const eth = byAddress('0x5aaeb6053f3e94c9b9a09f33669435e7ef1beaed');
    if (eth) {
      expect(eth.addressActivity.synthetic).to.equal(true);
      expect([eth.addressActivity.totalReceived, eth.addressActivity.totalSent, eth.addressActivity.transactionCount]).to.eql([10.2, 8.1, 5]);
      expect(eth.addressActivity.cashOutSignals.map((s) => [s.kind, s.occurredAt, s.amount, s.unit])).to.eql([
        ['STABLECOIN_SWAP', '2026-08-11T09:05:00Z', 21480, 'USDC'],
        ['EXCHANGE', '2026-08-12T11:30:00Z', 20000, 'USDC'],
      ]);
    }
  });
  test('missing Address Activity is unavailable with its limitation, never zero activity', () => {
    attributions.forEach((a) => expect(a.addressActivityStatus).to.be.oneOf(['AVAILABLE', 'UNAVAILABLE']));
    attributions.filter((a) => a.addressActivityStatus === 'UNAVAILABLE').forEach((a) => {
      expect(a.addressActivity).to.equal(null);
      expect(body.limitations).to.include('BLOCKCHAIN_DATA_UNAVAILABLE');
    });
  });
  test('limitations name the unavailable source and the incomplete Analysis', () => {
    expect(body.limitations).to.include.members(['SOURCE_UNAVAILABLE', 'ANALYSIS_INCOMPLETE']);
  });
}
