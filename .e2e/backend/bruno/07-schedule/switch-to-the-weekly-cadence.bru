meta {
  name: Switch to the weekly cadence
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/1/cases/{{caseId}}/schedule
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "enabled": true,
    "cadence": "WEEKLY"
  }
}

tests {
  const body = res.getBody();
  test('200 OK', () => expect(res.getStatus()).to.equal(200));
  const warsaw = (iso) => {
    const instant = new Date(iso);
    const lastSunday = (month) => {
      const day = new Date(Date.UTC(instant.getUTCFullYear(), month + 1, 0, 1));
      day.setUTCDate(day.getUTCDate() - day.getUTCDay());
      return day;
    };
    const offset = instant >= lastSunday(2) && instant < lastSunday(9) ? 2 : 1;
    const local = new Date(instant.getTime() + offset * 3600000);
    return { weekday: local.getUTCDay(), hour: local.getUTCHours(), minute: local.getUTCMinutes() };
  };
  test('weekly on Monday 06:00 Europe/Warsaw', () => {
    expect(body.cadence).to.equal('WEEKLY');
    const next = warsaw(body.nextExecutionAt);
    expect([next.weekday, next.hour, next.minute]).to.eql([1, 6, 0]);
  });
}
