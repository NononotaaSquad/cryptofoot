meta {
  name: Disable the schedule
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/1/cases/{{caseId}}/schedule
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "enabled": false
  }
}

tests {
  const body = res.getBody();
  test('200 OK', () => expect(res.getStatus()).to.equal(200));
  test('disabled, cadence kept, no next execution', () => {
    expect(body.enabled).to.equal(false);
    expect(body.cadence).to.equal('WEEKLY');
    expect(body.nextExecutionAt).to.equal(null);
  });
}
