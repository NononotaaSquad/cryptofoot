meta {
  name: Reject an ETH wallet with a bad checksum
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/1/cases
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "walletAddress": "0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAEd"
  }
}

tests {
  const body = res.getBody();
  test('400 Bad Request', () => expect(res.getStatus()).to.equal(400));
  test('rejects walletAddress only', () => {
    expect(body.message).to.equal('Popraw błędy w formularzu.');
    expect(body.errors).to.have.lengthOf(1);
    expect(body.errors[0].field).to.equal('walletAddress');
    expect(body.errors[0].message).to.equal('Adres portfela ma nieprawidłową sumę kontrolną.');
  });
}
