meta {
  name: Reject a wallet of an unsupported network
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/1/cases
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nickname": "zenek_fx",
    "walletAddress": "LdP8Qox1VAhCzLJNqrr74YovaWYyNBUWvL"
  }
}

tests {
  const body = res.getBody();
  test('400 Bad Request', () => expect(res.getStatus()).to.equal(400));
  test('rejects walletAddress only', () => {
    expect(body.message).to.equal('Popraw błędy w formularzu.');
    expect(body.errors).to.have.lengthOf(1);
    expect(body.errors[0].field).to.equal('walletAddress');
    expect(body.errors[0].message).to.equal('Nieobsługiwany format adresu portfela. Obsługiwane są adresy Bitcoin (BTC) i Ethereum (ETH).');
  });
}
