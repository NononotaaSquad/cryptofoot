meta {
  name: Reject malformed JSON
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/1/cases
  body: text
  auth: none
}

headers {
  Content-Type: application/json
}

body:text {
  {not json
}

tests {
  const body = res.getBody();
  test('400 Bad Request', () => expect(res.getStatus()).to.equal(400));
  test('error body carries code 400 and the Polish message', () => {
    expect(body.code).to.equal(400);
    expect(body.message).to.equal('Nieprawidłowe żądanie.');
  });
  test('no parser details leak', () => expect(body.errors).to.eql([]));
}
