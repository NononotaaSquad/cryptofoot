meta {
  name: Reject an invalid e-mail
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/1/cases
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nickname": "zenek_fx",
    "email": "not-an-email"
  }
}

tests {
  const body = res.getBody();
  test('400 Bad Request', () => expect(res.getStatus()).to.equal(400));
  test('rejects email only', () => {
    expect(body.message).to.equal('Popraw błędy w formularzu.');
    expect(body.errors).to.have.lengthOf(1);
    expect(body.errors[0].field).to.equal('email');
    expect(body.errors[0].message).to.equal('Podaj poprawny adres e-mail.');
  });
}
