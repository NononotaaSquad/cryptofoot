meta {
  name: Readiness is UP
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/actuator/health/readiness
  body: none
  auth: none
}

tests {
  const body = res.getBody();
  test('200 OK', () => expect(res.getStatus()).to.equal(200));
  test('status is UP', () => expect(body.status).to.equal('UP'));
}
