meta {
  name: Comparison in reversed order is rejected
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/1/cases/{{caseId}}/comparison?earlierAnalysisId={{laterAnalysisId}}&laterAnalysisId={{analysisId}}
  body: none
  auth: none
}

tests {
  const body = res.getBody();
  test('400 Bad Request', () => expect(res.getStatus()).to.equal(400));
  test('error body carries code 400 and the Polish message', () => {
    expect(body.code).to.equal(400);
    expect(body.message).to.equal('Analiza wcześniejsza musi rozpocząć się przed późniejszą.');
  });
}
