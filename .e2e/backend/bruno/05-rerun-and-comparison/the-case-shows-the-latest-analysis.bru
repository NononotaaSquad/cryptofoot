meta {
  name: The Case shows the latest Analysis
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/1/cases/{{caseId}}
  body: none
  auth: none
}

tests {
  const body = res.getBody();
  test('200 OK', () => expect(res.getStatus()).to.equal(200));
  test('latestAnalysis is the rerun', () => {
    expect(body.latestAnalysis.id).to.equal(bru.getVar('laterAnalysisId'));
    expect(body.latestAnalysis.status).to.equal('PARTIAL');
  });
}
