meta {
  name: Create a Case from a wallet address only
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/1/cases
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "walletAddress": "  0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed  "
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar('walletCaseId', body.id);
}

tests {
  const body = res.getBody();
  test('201 Created', () => expect(res.getStatus()).to.equal(201));
  test('the wallet is trimmed and stored in canonical (lowercase) form', () => {
    expect(body.identifiers.walletAddress).to.equal('0x5aaeb6053f3e94c9b9a09f33669435e7ef1beaed');
  });
  test('the wallet is the only identifier', () => {
    expect(body.identifiers.nickname).to.equal(null);
    expect(body.identifiers.email).to.equal(null);
    expect(body.identifiers.fullName).to.equal(null);
  });
}
